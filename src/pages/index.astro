---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---

<BaseLayout
  title="Pachamamicos: meditación, mindfulness y espiritualidad en Chile"
  description={site.description}
  home
>
  <div class="mx-auto max-w-contenido px-5 py-12 md:px-8">
    <p class="font-logo text-hero leading-none">pachamamicos</p>
    <h1 class="mt-10 font-titulo text-h1 font-bold">¿Dónde meditar en Santiago?</h1>
    <p class="mt-4 max-w-lectura text-cuerpo">
      Contenido de prueba para verificar el layout.
    </p>
  </div>
</BaseLayout>