---
import BaseLayout from '../layouts/BaseLayout.astro';
import Boton from '../components/ui/Boton.astro';
---

<BaseLayout
  title="Página no encontrada"
  description="La página que buscas no existe o cambió de lugar."
  noindex
>
  <section class="mx-auto flex max-w-contenido flex-col items-center px-5 py-16 text-center md:px-8 md:py-24">

    <p class="mt-8 rounded-full border-2 border-lima bg-superficie px-3 py-1 texto-ui text-chico text-lima">
      Error 404
    </p>

    <h1 class="mt-4 max-w-2xl text-h1">
      Esta página no existe (o se fue a meditar)
    </h1>

    <p class="mt-4 max-w-lectura text-cuerpo text-texto-suave">
      Puede que el enlace haya cambiado o tenga un error. Vuelve al inicio o mira las guías.
    </p>

    <div class="mt-8 flex flex-wrap justify-center gap-4">
      <Boton href="/">Volver al inicio</Boton>
      <Boton href="/guias/" variante="secundario">Ver las guías</Boton>
    </div>
  </section>
</BaseLayout>