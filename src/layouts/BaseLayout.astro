---
import '../styles/global.css';
import '@fontsource/ranchers/latin-400.css';
import '@fontsource/anton/latin-400.css';
import '@fontsource-variable/nunito-sans';
import Seo from '../components/base/Seo.astro';
import Header from '../components/base/Header.astro';
import Footer from '../components/base/Footer.astro';

interface Props {
  title: string;
  description: string;
  home?: boolean;
  type?: 'website' | 'article';
  image?: string;
  noindex?: boolean;
}

const props = Astro.props;
---

<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo {...props} />
  </head>
<body class="flex min-h-dvh flex-col">
  <a
    href="#contenido"
    class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-amarillo focus:px-5 focus:py-3 focus:texto-ui focus:text-tinta"
  >
    Saltar al contenido
  </a>

  <Header />

  <main id="contenido" class="flex-1">
    <slot />
  </main>

  <Footer />
</body>
</html>